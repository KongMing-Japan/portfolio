{
  "name": "portfolio-web",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "极简、多券商、多币种的个人投资组合生成器",
  "scripts": {
    "dev": "vite",
    "dev:cf": "npm run build && wrangler pages dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name=portfolio",
    "cf:types": "wrangler types --strict-vars false",
    "fetch:prices": "node scripts/fetch-prices.js",
    "fetch:superinvestors": "node scripts/fetch-superinvestors.mjs",
    "ai:sync": "node scripts/ai-fund-sync.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.9.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260623.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
